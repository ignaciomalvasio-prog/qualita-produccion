rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Editor: cuenta de Google verificada cuyo mail figura como documento en /editores.
    function esEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/editores/$(request.auth.token.email));
    }
    // Vendedor externo: cuenta de Google verificada cuyo mail figura como documento en /vendedores.
    function esVendedor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/vendedores/$(request.auth.token.email));
    }
    function esMia(d) { return d.vendedor == request.auth.token.email; }
    // Lo que puede escribir un vendedor: solo su pedido, pendiente, con estos campos y nada más (sin precios ni camión).
    function ventaValida() {
      let d = request.resource.data;
      // Un envío de foto o mensaje (tipo "archivo") va sin cliente ni fecha: los lee Qualitá.
      let archivo = d.get('tipo', '') == 'archivo';
      return d.keys().hasOnly(['vendedor', 'nombre', 'cliente', 'entrega', 'medias', 'peso', 'frio', 'cortes', 'nota', 'estado', 'creado', 'ts', 'editado', 'tipo', 'fotos', 'mensaje'])
        && esMia(d) && d.estado == 'pendiente'
        && d.cliente is string && d.cliente.size() <= 120 && (d.cliente.size() > 0 || archivo)
        && d.entrega is string && (d.entrega.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') || (archivo && d.entrega == ''))
        && d.medias is number && d.medias >= 0 && d.medias <= 5000
        && d.cortes is list && d.cortes.size() <= 40
        && (!('nota' in d) || (d.nota is string && d.nota.size() <= 1000))
        && (!('fotos' in d) || (d.fotos is list && d.fotos.size() <= 4))
        && (!('mensaje' in d) || (d.mensaje is string && d.mensaje.size() <= 20000))
        && (!archivo || d.get('fotos', []).size() > 0 || d.get('mensaje', '').size() > 0);
    }
    match /vendedores/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }
    // Pedidos que cargan los vendedores desde /vendedor. Cada uno ve y toca solo los suyos, y solo
    // mientras están pendientes; los editores los aceptan o rechazan desde la app.
    match /ventas/{id} {
      allow read: if esEditor() || (esVendedor() && esMia(resource.data));
      allow create: if esVendedor() && ventaValida();
      allow update: if esEditor() || (esVendedor() && esMia(resource.data) && resource.data.estado == 'pendiente' && ventaValida());
      allow delete: if esEditor() || (esVendedor() && esMia(resource.data) && resource.data.estado == 'pendiente');
    }
    // La lista de editores solo se cambia desde la consola de Firebase.
    match /editores/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, write: if false;
    }
    // Lo que ven todos: planilla de medias, orden de produccion y configuracion.
    match /faena/{doc}      { allow read: if true; allow write: if esEditor(); }
    match /produccion/{doc} { allow read: if true; allow write: if esEditor(); }
    match /config/{doc}     { allow read: if true; allow write: if esEditor(); }
    // Solo editores: pedidos cargados y la clave de IA.
    match /pedidos/{doc}    { allow read, write: if esEditor(); }
    match /privado/{doc}    { allow read, write: if esEditor(); }
  }
}
